<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- ══ HEADER ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="44dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS"
                android:textColor="@color/accent_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                android:letterSpacing="0.25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUARD"
                android:textColor="@color/accent_cyan"
                android:textSize="44sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginTop="-12dp" />

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حارس السماعة"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ══ STATUS CARD ══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:background="@drawable/circle_indicator" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="غير نشط"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اضبط الوقت وفعّل الجدول"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="23dp" />

                <TextView
                    android:id="@+id/tvRemainingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="الوقت المتبقي للانتهاء"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="22dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/accent_danger"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ TIME CARD ══ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نطاق فترة الحجب"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="البداية"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:layout_marginBottom="7dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:text="22:00"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            app:backgroundTint="@color/bg_surface"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textColor="@color/text_muted"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:paddingTop="20dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="النهاية"
                            android:textColor="@color/accent_primary"
                            android:textSize="11sp"
                            android:layout_marginBottom="7dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEndTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:text="06:00"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            app:backgroundTint="@color/bg_surface"
                            app:strokeColor="@color/divider"
                            app:strokeWidth="1dp"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اضغط على الوقت لتعديله"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══ ACTIVATE BUTTON ══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="تفعيل الجدول"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="18dp"
            android:layout_marginBottom="26dp" />

        <!-- ══ DIVIDER ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/divider" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  الصلاحيات المطلوبة  "
                android:textColor="@color/text_muted" android:textSize="11sp" />

            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/divider" />
        </LinearLayout>

        <!-- ══ PERMISSION BUTTONS ══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdmin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="تفعيل صلاحيات المشرف"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/bg_card"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccess"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="تفعيل خدمة الحماية"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/bg_card"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
